# Original game files and everything derived from them are NEVER committed
# (copyrighted by Play Byte / Bones Park; the port uses a "bring your own UGH.EXE" model)
1_original/*
!1_original/README.md
*.EXE
*.exe
*.COM
*.HI
assets/

# Ghidra project, decompiled code and dumps derived from UGH.EXE
2_reverse_engineering/ghidra-project/
2_reverse_engineering/out/

# Gradle / IDE
.gradle/
build/
.idea/
.kotlin/
*.iml

# Unreal Engine project: build output and caches, and the vendor plugins (DLSS, FSR: copied by 5_remake/game/setup.ps1)
5_remake/game/Binaries/
5_remake/game/Intermediate/
5_remake/game/Saved/
5_remake/game/DerivedDataCache/
5_remake/game/Plugins/
5_remake/game/.vs/
5_remake/game/*.sln
# written by the engine with its defaults (the game takes raw key events, no input settings)
5_remake/game/Config/DefaultInput.ini
# the materials: made by the commandlet UghMakeAssets on every build.ps1
5_remake/game/Content/Generated/
# the 3D assets of assets/3d imported by the commandlet UghImportAssets (build.ps1)
5_remake/game/Content/Imported/
# the copy of Epic's Electric Dreams sample (electric-dreams.ps1) and the MetaHumans (metahumans.ps1): licensed for
# Unreal Engine projects, not ours to share
5_remake/game/Content/External/
# Python caches of the Blender and editor scripts (5_remake/game/Blender, 5_remake/game/Python)
__pycache__/
# packaged game and the PSO cache recorded for it (package.ps1, pso.ps1)
5_remake/game/Packaged/
5_remake/game/Build/Windows/PipelineCaches/
